<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <permission android:name="com.garage.bandcontrol.installer.PHONE_INSTALL_STATUS"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.garage.bandcontrol.installer.PHONE_INSTALL_STATUS" />

    <queries>
        <package android:name="com.garage.bandcontrol" />
        <package android:name="com.mi.health" />
        <package android:name="com.xiaomi.wearable" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_installer"
        android:roundIcon="@mipmap/ic_installer"
        android:label="@string/app_name"
        android:theme="@style/InstallerTheme">
        <activity
            android:name=".InstallerActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- Preserve the launcher component used by earlier versions. -->
        <activity-alias
            android:name="com.garage.bandcontrol.installer.InstallerActivity"
            android:exported="true"
            android:targetActivity=".InstallerActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
