<template>
  <stack class="page">
    <stack class="theme-layer">
      <image class="theme-background" if="{{ themeArt }}" src="{{ themeArt }}" @error="onThemeImageError"></image>
    </stack>
    <div class="home-layout-pending" if="{{ !homeLayoutReady }}"><text class="{{ 'home-layout-pending-text' + themeInk }}">正在载入车况…</text></div>
    <scroll id="homeScroll" class="{{ ui.scrollPage }}" scroll-y="true" focusable="true" if="{{ homeLayoutReady && !settingsOpen && !useTwoPageShell && !isCircularShell }}">
      <div class="{{ ui.homeScreen }}">
        <div class="{{ ui.range + themePanelClass }}" @click="toggleRange">
          <div class="{{ ui.rangeHeader }}">
            <text class="{{ ui.model + themeInk }}">{{ vehicleName }}</text>
            <text class="{{ ui.motion + themeMuted }}">{{ motion || '—' }}</text>
          </div>
          <div class="range-summary" if="{{ !showTotalRange }}">
            <text class="{{ ui.distance + ' range-total' + themeInk }}"><span class="{{ ui.totalLabel + themeInk }}">总里程: </span>{{ total }}<span class="{{ ui.unit + themeMuted }}">{{ totalUnit }}</span></text>
            <div class="range-breakdown range-breakdown-summary">
              <div class="range-breakdown-reading" for="{{ rangeBreakdown }}" tid="id">
                <image class="{{ 'range-breakdown-icon' + (canEditTheme ? '' : ' range-breakdown-icon-narrow') }}" src="{{ themeIconPath + 'energy-' + $item.id + '.png' }}"></image>
                <text class="{{ 'range-breakdown-value' + (canEditTheme ? '' : ' range-breakdown-value-narrow') + themeMuted }}">{{ $item.value }}</text>
              </div>
            </div>
          </div>
          <image class="{{ ui.vehicleImage }}" src="{{ carImageSrc }}" @error="onCarImageError"></image>
          <div class="{{ ui.split }}" if="{{ showTotalRange }}">
            <div class="{{ ui.energy + themeControl }}">
              <div class="{{ ui.energyReading }}">
                <image class="{{ ui.energyIcon }}" src="{{ themeIconPath + 'energy-electric.png' }}"></image>
                <text class="{{ (electric.length > 3 ? ui.distanceCompact : ui.distance) + themeInk }}">{{ electric }}<span class="{{ ui.unit + themeMuted }}">{{ electricUnit }}</span></text>
              </div>
              <div class="{{ ui.energyTrack }}">
                <div class="{{ ui.energyFill }} electric-fill" if="{{ electricPercent > 0 }}" style="width: {{ electricPercent }}%"></div>
              </div>
            </div>
            <div class="{{ ui.energy + themeControl }}">
              <div class="{{ ui.energyReading }}">
                <image class="{{ ui.energyIcon }}" src="{{ themeIconPath + 'energy-fuel.png' }}"></image>
                <text class="{{ (fuel.length > 3 ? ui.distanceCompact : ui.distance) + themeInk }}">{{ fuel }}<span class="{{ ui.unit + themeMuted }}">{{ fuelUnit }}</span></text>
              </div>
              <div class="{{ ui.energyTrack }}">
                <div class="{{ ui.energyFill }} fuel-fill" if="{{ fuelPercent > 0 }}" style="width: {{ fuelPercent }}%"></div>
              </div>
            </div>
          </div>
          <div class="{{ ui.rangeIndicators }}">
            <div class="{{ showTotalRange ? ui.rangeDot : ui.activeRangeDot }}"></div>
            <div class="{{ showTotalRange ? ui.activeRangeDot : ui.rangeDot }}"></div>
          </div>
        </div>
        <div class="{{ ui.vehicleMeta + themePanelClass }}">
          <div class="{{ ui.refresh }}" @click="refresh">
            <image class="{{ ui.refreshIcon }}" src="{{ themeIconPath + 'refresh.png' }}"></image>
            <text class="{{ ui.updated + themeMuted }}">{{ refreshText }}</text>
          </div>
          <div class="{{ ui.metaDivider }}"></div>
          <div class="{{ ui.connection }}" @click="openSettings">
            <div class="{{ ui.connectionStatus }}">
              <div class="{{ modeLabel === '已连接' || modeLabel === '演示' ? ui.dot + ' online' : ui.dot }}"></div>
              <text class="{{ ui.mode + themeMuted }}">{{ modeLabel }}</text>
            </div>
            <image class="{{ ui.settingsIcon }}" src="{{ themeIconPath + 'settings.png' }}"></image>
          </div>
        </div>
        <text class="{{ ui.empty + themeMuted + themeControl }}" if="{{ compatibilityNotice }}">{{ compatibilityNotice }}</text>
        <div class="{{ ui.grid }}" if="{{ !compatibilityNotice }}">
          <div class="{{ ui.controlRow }}" for="{{ displayRows }}" tid="id">
            <div class="{{ $item.first.style + themeTileClass + $item.first.tileStateStyle }}" @click="select($item.first.id)">
              <div class="{{ $item.first.symbolStyle + themeTileIconClass }}">
                <image class="{{ $item.first.iconStyle }}" src="{{ $item.first.icon }}" @error="onControlIconError($item.first.id)"></image>
              </div>
              <div class="{{ $item.first.copyStyle }}">
                <text class="{{ $item.first.labelStyle + $item.first.labelToneStyle }}">{{ $item.first.displayLabel }}</text>
                <text if="{{ $item.first.displayHint }}" class="{{ $item.first.hintStyle + themeMuted }}">{{ $item.first.displayHint }}</text>
              </div>
            </div>
            <div if="{{ $item.second.id }}" class="{{ $item.second.style + themeTileClass + $item.second.tileStateStyle }}" @click="select($item.second.id)">
              <div class="{{ $item.second.symbolStyle + themeTileIconClass }}">
                <image class="{{ $item.second.iconStyle }}" src="{{ $item.second.icon }}" @error="onControlIconError($item.second.id)"></image>
              </div>
              <div class="{{ $item.second.copyStyle }}">
                <text class="{{ $item.second.labelStyle + $item.second.labelToneStyle }}">{{ $item.second.displayLabel }}</text>
                <text if="{{ $item.second.displayHint }}" class="{{ $item.second.hintStyle + themeMuted }}">{{ $item.second.displayHint }}</text>
              </div>
            </div>
          </div>
          <text class="{{ ui.empty + themeMuted + themeControl }}" if="{{ displayRows.length === 0 }}">{{ emptyLabel }}</text>
        </div>
      </div>
    </scroll>
    <div id="circleSingleShell" class="{{ 'watch-page watch-single-page' + (themeArt ? '' : ' watch-mileage-page-classic') }}" focusable="true" if="{{ homeLayoutReady && !settingsOpen && !useTwoPageShell && isCircularShell }}">
      <div class="watch-single-top" @click="refresh">
        <image class="watch-single-refresh-icon" src="/common/images/refresh.png"></image>
        <text class="watch-single-top-text">{{ refreshText }}</text>
      </div>
      <text class="watch-single-range" if="{{ singleCircleRangeText }}">{{ singleCircleRangeText }}</text>
      <image class="{{ displayRows.length > 1 ? 'watch-single-car watch-single-car-grid' : 'watch-single-car' }}" src="{{ carImageSrc }}" @error="onCarImageError"></image>
      <text class="{{ watchControlsUi.empty + themeMuted + themeControl }}" if="{{ compatibilityNotice }}">{{ compatibilityNotice }}</text>
      <div class="watch-single-grid" if="{{ !compatibilityNotice }}">
        <div class="{{ displayRows.length > 1 ? 'watch-control-row watch-single-row-grid' : 'watch-control-row watch-single-row' }}" for="{{ displayRows }}" tid="id">
          <div class="{{ $item.first.watchCellStyle + (displayRows.length > 1 ? ' watch-cell-single-grid' : ' watch-cell-single-compact') + themeTileClass + $item.first.watchCellStateStyle }}" @click="select($item.first.id)">
            <div class="{{ $item.first.watchOrbStyle + ' ' + $item.first.watchOrbSizeStyle + $item.first.watchOrbDayStyle }}">
              <image class="{{ $item.first.watchOrbIconStyle + (displayRows.length > 1 ? ' watch-orb-icon-single-grid' : '') }}" src="{{ $item.first.icon }}" @error="onControlIconError($item.first.id)"></image>
            </div>
            <div class="{{ $item.first.watchCellCopyStyle }}">
              <text class="{{ $item.first.watchCellLabelStyle + $item.first.labelToneStyle }}">{{ $item.first.displayLabel }}</text>
              <text if="{{ $item.first.displayHint }}" class="{{ 'watch-cell-hint' + themeMuted }}">{{ $item.first.displayHint }}</text>
            </div>
          </div>
          <div if="{{ $item.second.id }}" class="{{ $item.second.watchCellStyle + (displayRows.length > 1 ? ' watch-cell-single-grid' : ' watch-cell-single-compact') + themeTileClass + $item.second.watchCellStateStyle }}" @click="select($item.second.id)">
            <div class="{{ $item.second.watchOrbStyle + ' ' + $item.second.watchOrbSizeStyle + $item.second.watchOrbDayStyle }}">
              <image class="{{ $item.second.watchOrbIconStyle + (displayRows.length > 1 ? ' watch-orb-icon-single-grid' : '') }}" src="{{ $item.second.icon }}" @error="onControlIconError($item.second.id)"></image>
            </div>
            <div class="{{ $item.second.watchCellCopyStyle }}">
              <text class="{{ $item.second.watchCellLabelStyle + $item.second.labelToneStyle }}">{{ $item.second.displayLabel }}</text>
              <text if="{{ $item.second.displayHint }}" class="{{ 'watch-cell-hint' + themeMuted }}">{{ $item.second.displayHint }}</text>
            </div>
          </div>
          <div if="{{ $item.third && $item.third.id }}" class="{{ $item.third.watchCellStyle + ' watch-cell-single-compact' + themeTileClass + $item.third.watchCellStateStyle }}" @click="select($item.third.id)">
            <div class="{{ $item.third.watchOrbStyle + ' ' + $item.third.watchOrbSizeStyle + $item.third.watchOrbDayStyle }}">
              <image class="{{ $item.third.watchOrbIconStyle }}" src="{{ $item.third.icon }}" @error="onControlIconError($item.third.id)"></image>
            </div>
            <div class="{{ $item.third.watchCellCopyStyle }}">
              <text class="{{ $item.third.watchCellLabelStyle + $item.third.labelToneStyle }}">{{ $item.third.displayLabel }}</text>
              <text if="{{ $item.third.displayHint }}" class="{{ 'watch-cell-hint' + themeMuted }}">{{ $item.third.displayHint }}</text>
            </div>
          </div>
        </div>
        <text class="{{ watchControlsUi.empty + themeMuted + themeControl }}" if="{{ displayRows.length === 0 }}">{{ emptyLabel }}</text>
      </div>
      <div class="{{ 'watch-settings-pill watch-single-settings-pill' + themeTileClass }}" @click="openSettings">
        <image class="watch-settings-icon" src="{{ themeIconPath + 'settings.png' }}"></image>
        <text class="{{ 'watch-settings-text' + themeInk }}">设置</text>
      </div>
    </div>
    <stack class="{{ themeArt ? 'watch-shell' : 'watch-shell watch-shell-classic' }}" if="{{ homeLayoutReady && !settingsOpen && useTwoPageShell }}">
      <swiper id="watchSwiper" class="watch-swiper" vertical="true" indicator="false" loop="false" focusable="true" enableswipe="{{ !confirmTitle }}" index="{{ watchPage }}" @change="onWatchPageChange">
        <div class="{{ watchHomeUi.mileagePage + (themeArt ? '' : ' watch-mileage-page-classic') }}">
          <div class="{{ 'watch-connection-row' + (layoutProfile === 'circle' ? ' watch-connection-row-circle' : (layoutProfile === 'rect' || layoutProfile === 'square' ? ' watch-connection-row-rect' : '')) }}">
            <text class="watch-model-top-left" if="{{ layoutProfile === 'rect' || layoutProfile === 'square' }}">{{ vehicleName }}</text>
            <div class="watch-connection" @click="refresh">
              <div class="{{ (modeLabel === '已连接' || modeLabel === '演示') ? 'dot online' : 'dot' }}"></div>
              <text class="watch-connection-text">{{ modeLabel }}</text>
            </div>
          </div>
          <div class="{{ watchHomeUi.heroHeader }}">
            <text class="{{ watchHomeUi.model }}" if="{{ layoutProfile !== 'rect' && layoutProfile !== 'square' }}">{{ vehicleName }}</text>
            <div class="watch-hero-num-row">
              <text class="{{ watchHomeUi.heroUnitGhost }}">{{ totalUnit || '\u00a0km' }}</text>
              <text class="{{ watchHomeUi.hero }}">{{ total }}</text>
              <text class="{{ watchHomeUi.heroUnit }}">{{ totalUnit }}</text>
            </div>
            <div class="watch-energy-summary">
              <div class="watch-energy-item" for="{{ rangeBreakdown }}" tid="id">
                <div class="watch-energy-reading">
                  <image class="watch-energy-icon" src="{{ '/common/images/energy-' + $item.id + '.png' }}"></image>
                  <text class="watch-energy-value">{{ $item.value }}</text>
                </div>
                <div class="watch-energy-track">
                  <div class="{{ 'watch-energy-fill ' + $item.id + '-fill' }}" if="{{ $item.percent > 0 }}" style="width: {{ $item.percent }}%"></div>
                </div>
              </div>
            </div>
          </div>
          <image class="{{ watchHomeUi.car }}" src="{{ carImageSrc }}" @error="onCarImageError"></image>
          <div class="watch-home-footer">
            <div class="watch-motion-group">
              <image class="watch-motion-icon" if="{{ motion === '已驻车' }}" src="/common/images/parking-status.png"></image>
              <text class="watch-motion">{{ motion }}</text>
            </div>
            <div class="watch-next-page" @click="setWatchPage(1)">
              <image class="watch-next-icon" src="/common/images/chevron-down.png"></image>
            </div>
          </div>
        </div>
        <div class="{{ watchControlsUi.controlsPage + (themeArt ? '' : ' watch-controls-page-classic') }}"
             @touchstart="startControlsPull" @touchmove="moveControlsPull" @touchend="endControlsPull">
          <div class="{{ watchControlsUi.topPill }}" @click="refresh">
            <image class="{{ watchControlsUi.refreshIcon }}" src="/common/images/refresh.png"></image>
            <text class="{{ watchControlsUi.topText }}">{{ controlsPullText || refreshText }}</text>
            <div class="watch-pull-progress" if="{{ controlsPullProgress > 0 || refreshing }}">
              <div class="watch-pull-fill" style="width: {{ refreshing ? 100 : controlsPullProgress }}%"></div>
            </div>
          </div>
          <text class="{{ watchControlsUi.empty + themeMuted + themeControl }}" if="{{ compatibilityNotice }}">{{ compatibilityNotice }}</text>
          <div class="{{ watchControlsUi.grid }}" if="{{ !compatibilityNotice }}" style="transform: {{ controlsPullTransform }}">
            <div class="{{ watchControlsUi.controlRow }}" for="{{ displayRows }}" tid="id">
              <div class="{{ $item.first.watchCellStyle + themeTileClass + $item.first.watchCellStateStyle }}" @click="select($item.first.id)">
                <div class="{{ $item.first.watchOrbStyle + ' ' + $item.first.watchOrbSizeStyle + $item.first.watchOrbDayStyle }}">
                  <image class="{{ $item.first.watchOrbIconStyle }}" src="{{ $item.first.icon }}" @error="onControlIconError($item.first.id)"></image>
                </div>
                <div class="{{ $item.first.watchCellCopyStyle }}">
                  <text class="{{ $item.first.watchCellLabelStyle + $item.first.labelToneStyle }}">{{ $item.first.displayLabel }}</text>
                  <text if="{{ $item.first.displayHint }}" class="{{ 'watch-cell-hint' + themeMuted }}">{{ $item.first.displayHint }}</text>
                </div>
              </div>
              <div if="{{ $item.second.id }}" class="{{ $item.second.watchCellStyle + themeTileClass + $item.second.watchCellStateStyle }}" @click="select($item.second.id)">
                <div class="{{ $item.second.watchOrbStyle + ' ' + $item.second.watchOrbSizeStyle + $item.second.watchOrbDayStyle }}">
                  <image class="{{ $item.second.watchOrbIconStyle }}" src="{{ $item.second.icon }}" @error="onControlIconError($item.second.id)"></image>
                </div>
                <div class="{{ $item.second.watchCellCopyStyle }}">
                  <text class="{{ $item.second.watchCellLabelStyle + $item.second.labelToneStyle }}">{{ $item.second.displayLabel }}</text>
                  <text if="{{ $item.second.displayHint }}" class="{{ 'watch-cell-hint' + themeMuted }}">{{ $item.second.displayHint }}</text>
                </div>
              </div>
              <div if="{{ $item.third && $item.third.id }}" class="{{ $item.third.watchCellStyle + themeTileClass + $item.third.watchCellStateStyle }}" @click="select($item.third.id)">
                <div class="{{ $item.third.watchOrbStyle + ' ' + $item.third.watchOrbSizeStyle + $item.third.watchOrbDayStyle }}">
                  <image class="{{ $item.third.watchOrbIconStyle }}" src="{{ $item.third.icon }}" @error="onControlIconError($item.third.id)"></image>
                </div>
                <div class="{{ $item.third.watchCellCopyStyle }}">
                  <text class="{{ $item.third.watchCellLabelStyle + $item.third.labelToneStyle }}">{{ $item.third.displayLabel }}</text>
                  <text if="{{ $item.third.displayHint }}" class="{{ 'watch-cell-hint' + themeMuted }}">{{ $item.third.displayHint }}</text>
                </div>
              </div>
            </div>
            <text class="{{ watchControlsUi.empty + themeMuted + themeControl }}" if="{{ displayRows.length === 0 }}">{{ emptyLabel }}</text>
          </div>
          <div class="{{ watchControlsUi.settingsPill + themeTileClass }}" @click="openSettings">
            <image class="{{ watchControlsUi.settingsIcon }}" src="{{ themeIconPath + 'settings.png' }}"></image>
            <text class="{{ watchControlsUi.settingsText + themeInk }}">设置</text>
          </div>
        </div>
      </swiper>
      <div class="{{ watchControlsUi.pager }}">
        <div class="{{ watchPage === 0 ? 'watch-pager-dot watch-pager-active' : 'watch-pager-dot' }}" @click="setWatchPage(0)"></div>
        <div class="{{ watchPage === 1 ? 'watch-pager-dot watch-pager-active' : 'watch-pager-dot' }}" @click="setWatchPage(1)"></div>
      </div>
    </stack>
    <div class="confirm-overlay" if="{{ confirmTitle }}" @touchstart="clearControlsPull" @swipe="onOverlaySwipe">
      <div class="{{ ui.confirmation + (themeDay ? ' theme-confirmation-day' : '') }}">
        <div class="{{ ui.confirmAction }}">
          <image class="{{ ui.confirmIcon }}" src="{{ themeConfirmIcon }}"></image>
          <text class="{{ ui.confirmTitle + themeInk }}">{{ confirmTitle }}</text>
        </div>
        <div class="{{ ui.confirmActions }}">
          <text class="{{ ui.confirmButton }}" @click="execute">确认</text>
          <text class="{{ ui.cancelButton + themeInk + themeControl }}" @click="cancel">取消</text>
        </div>
      </div>
    </div>
    <scroll id="settingsScroll" class="{{ ui.scrollPage + ' theme-settings-scroll' + themeStage }}" scroll-y="true" focusable="true" if="{{ settingsOpen && !themeEditorOpen && !confirmTitle }}" @swipe="onOverlaySwipe">
      <div class="{{ ui.settingsScreen }}">
        <text class="{{ ui.settingsTitle + themeInk }}">设置</text>
        <div class="{{ ui.diagnostics + ' theme-settings-entry' + themeControl }}" if="{{ canEditTheme }}" @click="openThemeEditor">
          <text class="{{ ui.diagnosticsTitle + themeInk }}">外观主题</text>
          <text class="{{ ui.diagnosticsLine + themeMuted }}">{{ themeSummary }}</text>
        </div>
        <div class="{{ ui.hapticsSetting + themeControl }}">
          <text class="{{ ui.hapticsLabel + themeInk }}">车控震动</text>
          <switch class="{{ ui.hapticsSwitch }}" checked="{{ hapticsEnabled }}" @change="changeHaptics"></switch>
        </div>
        <div class="{{ ui.hapticsSetting + themeControl }}" if="{{ canChangeDisplay }}">
          <text class="{{ ui.hapticsLabel + themeInk }}">双屏显示</text>
          <switch class="{{ ui.hapticsSwitch }}" checked="{{ twoPageChecked }}" @change="changeTwoPage"></switch>
        </div>
        <div class="{{ ui.diagnostics + themeControl }}">
          <text class="{{ ui.diagnosticsTitle + themeInk }}">连接记录</text>
          <text class="{{ ui.diagnosticsLine + themeMuted }}" if="{{ diagnosticLines.length === 0 }}">暂无记录</text>
          <text class="{{ ui.diagnosticsLine + themeMuted }}" for="{{ diagnosticLines }}">{{ $item }}</text>
        </div>
        <div class="{{ ui.settingsBack + themeControl }}" @click="closeSettings">
          <image class="{{ ui.settingsBackIcon }}" src="{{ themeIconPath + 'back.png' }}"></image>
          <text class="{{ ui.settingsBackText + themeInk }}">返回</text>
        </div>
      </div>
    </scroll>
    <scroll id="themeEditorScroll" class="{{ ui.scrollPage + ' theme-settings-scroll' + themeStage }}" scroll-y="true" focusable="true" if="{{ themeEditorOpen && !confirmTitle }}" @swipe="onOverlaySwipe">
      <div class="{{ ui.settingsScreen }}">
        <text class="{{ ui.settingsTitle + themeInk }}">外观主题</text>
        <picker class="{{ 'theme-picker' + themeControl }}" type="text" range="{{ themeNames }}" selected="{{ themeDraftChoice }}" @change="changeThemeChoice"></picker>
        <text class="{{ ui.diagnosticsLine + themeMuted }}" if="{{ themeDraftChoice === 0 }}">{{ themePhoneSummary }}</text>
        <div class="theme-fields" if="{{ themeDraftChoice > 1 }}">
          <picker class="{{ 'theme-picker' + themeControl }}" type="text" range="{{ themeModes }}" selected="{{ themeDraftMode }}" @change="changeThemeMode"></picker>
          <text class="{{ ui.settingsBack + themeInk + themeControl }}" if="{{ themeDraftMode === 0 }}" @click="toggleThemeTimes">{{ themeTimesExpanded ? '收起时间设置' : '自定义时间 · ' + themeDraftDay + ' / ' + themeDraftNight }}</text>
          <div class="theme-fields" if="{{ themeDraftMode === 0 && themeTimesExpanded }}">
            <text class="{{ ui.hapticsLabel + themeInk }}">日景开始</text>
            <picker class="{{ 'theme-picker' + themeControl }}" type="time" selected="{{ themeDraftDay }}" @change="changeThemeDay"></picker>
            <text class="{{ ui.hapticsLabel + themeInk }}">夜景开始</text>
            <picker class="{{ 'theme-picker' + themeControl }}" type="time" selected="{{ themeDraftNight }}" @change="changeThemeNight"></picker>
          </div>
        </div>
        <text class="{{ ui.diagnosticsLine + themeMuted }}" if="{{ themeEditorError }}">{{ themeEditorError }}</text>
        <text class="{{ ui.settingsBack + themeInk + themeControl }}" @click="saveThemeEditor">保存</text>
        <text class="{{ ui.settingsBack + themeInk + themeControl }}" @click="closeThemeEditor">取消</text>
      </div>
    </scroll>
    <div class="{{ ui.toast + themeControl }}" if="{{ toastText && !confirmTitle }}">
      <text class="{{ ui.toastText + themeInk }}">{{ toastText }}</text>
    </div>
  </stack>
</template>

<script>
import { createGaragePage } from '../../common/garage-page.js'

export default createGaragePage({ lite: false })
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #10161b;
}
.home-layout-pending,
.confirm-overlay {
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.home-layout-pending-text {
  color: #ebf2fc;
  font-size: 20px;
  text-align: center;
}
.confirm-overlay {
  background-color: rgba(7, 13, 25, 0.38);
}
.scroll-page {
  width: 100%;
  height: 100%;
  flex-direction: column;
}
.home-screen {
  width: 336px;
  padding: 22px 18px 14px;
  flex-direction: column;
}
.vehicle-meta {
  width: 300px;
  height: 48px;
  margin-top: 8px;
  border-radius: 14px;
  background-color: #213239;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.refresh {
  width: 174px;
  height: 48px;
  flex-direction: row;
  align-items: center;
}
.refresh-icon {
  width: 18px;
  height: 18px;
  margin-left: 10px;
  margin-right: 6px;
  object-fit: contain;
}
.meta-divider {
  width: 1px;
  height: 24px;
  background-color: #41565d;
}
.connection {
  width: 124px;
  height: 48px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.connection-status {
  width: 82px;
  margin-left: 8px;
  flex-direction: row;
  align-items: center;
}
.dot {
  width: 6px;
  height: 6px;
  margin-right: 5px;
  border-radius: 3px;
  background-color: #78868c;
}
.online {
  background-color: #9ee9ce;
}
.mode {
  width: 71px;
  color: #c5d5d4;
  font-size: 15px;
  lines: 1;
  text-overflow: ellipsis;
}
.settings-icon {
  width: 20px;
  height: 20px;
  margin-right: 10px;
  object-fit: contain;
}
.range {
  width: 300px;
  height: 187px;
  padding: 10px 12px 7px;
  border-radius: 22px;
  background-color: #18262c;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
}
.range-header {
  width: 276px;
  height: 36px;
  padding: 0 2px;
  align-items: center;
  justify-content: space-between;
}
.model {
  color: #e1edec;
  font-size: 26px;
  font-weight: bold;
  lines: 1;
  text-overflow: ellipsis;
}
.motion {
  color: #cbdad8;
  font-size: 18px;
  lines: 1;
  text-overflow: ellipsis;
}
.vehicle-image {
  width: 244px;
  height: 79px;
  object-fit: contain;
}
.split {
  width: 276px;
  height: 52px;
  justify-content: space-between;
}
.energy {
  width: 134px;
  height: 52px;
  padding: 5px 9px 8px;
  border-radius: 11px;
  background-color: #203139;
  flex-direction: column;
  justify-content: space-between;
}
.total-energy {
  width: 276px;
  padding: 0 9px;
  align-items: center;
  justify-content: center;
}
.energy-reading {
  height: 31px;
  align-items: center;
}
.energy-icon {
  width: 23px;
  height: 23px;
  margin-right: 6px;
  object-fit: contain;
}
.distance {
  color: #f4faf8;
  font-size: 27px;
  font-weight: bold;
  lines: 1;
}
.compact {
  font-size: 20px;
}
.total-label {
  color: #cbdad8;
  font-size: 18px;
  font-weight: normal;
}
.unit {
  color: #bacbd0;
  font-size: 15px;
  font-weight: normal;
}
.energy-track {
  width: 116px;
  height: 5px;
  border-radius: 3px;
  background-color: #4a585f;
}
.energy-fill {
  height: 5px;
  border-radius: 3px;
}
.electric-fill {
  background-color: #6fe7a5;
}
.fuel-fill {
  background-color: #74b7ff;
}
.range-indicators {
  width: 24px;
  height: 4px;
  justify-content: space-between;
}
.range-dot {
  width: 6px;
  height: 4px;
  border-radius: 2px;
  background-color: #53686b;
}
.active-range-dot {
  width: 12px;
  background-color: #9ee9ce;
}
.updated {
  width: 134px;
  color: #d4e4e2;
  font-size: 15px;
  lines: 1;
  text-overflow: ellipsis;
}
.grid {
  width: 300px;
  flex-direction: column;
}
.control-row {
  width: 300px;
  margin-top: 10px;
  justify-content: space-between;
}
.tile {
  width: 146px;
  height: 97px;
  padding: 4px 9px;
  border-radius: 18px;
  border-width: 0px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.full-tile {
  width: 300px;
  justify-content: center;
}
.ready {
  background-color: #1d3532;
}
.paused {
  background-color: #202c33;
}
.unassigned {
  background-color: #19252c;
}
.tile-symbol {
  width: 38px;
  height: 38px;
  margin-bottom: 3px;
  border-radius: 12px;
  background-color: rgba(0, 0, 0, 0);
  align-items: center;
  justify-content: center;
}
.symbol-ready {
  background-color: rgba(0, 0, 0, 0);
}
.tile-icon {
  width: 27px;
  height: 27px;
  object-fit: contain;
}
.muted-icon {
  opacity: 0.68;
}
.tile-copy {
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.tile-label {
  color: #f4faf8;
  font-size: 22px;
  font-weight: bold;
  text-align: center;
  lines: 1;
}
.tile-hint {
  color: #aabac0;
  font-size: 16px;
}
.tile-rect {
  width: 284px;
  height: 56px;
  margin-left: 8px;
  padding: 0 12px;
  border-radius: 14px;
  flex-direction: row;
  justify-content: center;
}
.tile-symbol-rect {
  margin-right: 10px;
  margin-bottom: 0;
}
.tile-icon-rect {
  width: 32px;
  height: 32px;
}
.tile-copy-rect {
  width: 94px;
}
.empty {
  width: 300px;
  height: 92px;
  margin-top: 10px;
  border-radius: 16px;
  color: #a9bcbf;
  background-color: #162026;
  font-size: 22px;
  text-align: center;
}
.toast {
  width: 280px;
  height: 80px;
  left: 28px;
  top: 108px;
  padding: 5px 12px;
  border-radius: 15px;
  background-color: #30434a;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.toast-text {
  color: #f4faf8;
  width: 256px;
  font-size: 19px;
  line-height: 23px;
  lines: 3;
  text-overflow: ellipsis;
  text-align: center;
}
.settings-screen {
  width: 336px;
  padding: 30px 18px 18px;
  flex-direction: column;
}
.settings-title {
  font-size: 29px;
  font-weight: bold;
  color: #f4faf8;
  margin-bottom: 16px;
}
.haptics-setting {
  width: 300px;
  height: 58px;
  padding: 0 12px;
  margin-bottom: 12px;
  border-radius: 16px;
  background-color: #213239;
  justify-content: space-between;
  align-items: center;
}
.haptics-label {
  font-size: 22px;
  color: #f4faf8;
}
.haptics-switch {
  width: 66px;
  track-color: #72c9ae;
}
.diagnostics {
  width: 300px;
  padding: 12px;
  border-radius: 16px;
  background-color: #18262c;
  flex-direction: column;
}
.diagnostics-title {
  font-size: 20px;
  color: #f4faf8;
  margin-bottom: 7px;
}
.diagnostics-line {
  width: 276px;
  min-height: 42px;
  margin-bottom: 5px;
  font-size: 16px;
  line-height: 19px;
  color: #b7c9c8;
  lines: 2;
  text-overflow: ellipsis;
}
.settings-back {
  width: 300px;
  height: 50px;
  margin-top: 12px;
  border-radius: 14px;
  background-color: #213239;
  color: #f4faf8;
  font-size: 20px;
  text-align: center;
  align-items: center;
  justify-content: center;
}
.settings-back-icon {
  width: 20px;
  height: 20px;
  margin-right: 6px;
  object-fit: contain;
}
.settings-back-text {
  color: #f4faf8;
  font-size: 20px;
  lines: 1;
}
.confirmation {
  width: 288px;
  padding: 16px;
  border-radius: 24px;
  background-color: #293d56;
  flex-direction: column;
  align-items: center;
}
.confirm-action {
  width: 100%;
  min-height: 52px;
  align-items: center;
  justify-content: center;
}
.confirm-icon {
  width: 34px;
  height: 34px;
  margin-right: 10px;
  object-fit: contain;
}
.confirm-title {
  max-width: 76%;
  color: #f4faf8;
  font-size: 22px;
  font-weight: bold;
  text-align: center;
  lines: 2;
  text-overflow: ellipsis;
}
.confirm-actions {
  width: 100%;
  margin-top: 16px;
  flex-direction: column;
}
.confirm-button, .cancel-button {
  width: 100%;
  height: 64px;
  border-radius: 18px;
  font-size: 23px;
  text-align: center;
}
.confirm-button {
  color: #142439;
  background-color: #c9ddf4;
  font-weight: bold;
}
.cancel-button {
  margin-top: 16px;
  color: #e7f3f2;
  background-color: #394f69;
}

