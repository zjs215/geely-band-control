}
.haptics-setting {
  width: 300px;
  height: 58px;
  padding: 0 12px;
  margin-bottom: 12px;
  border-radius: 16px;
  background-color: #213239;
  justify-content: space-between;
  align-items: center;
}
.haptics-label {
  font-size: 22px;
  color: #f4faf8;
}
.haptics-switch {
  width: 66px;
  track-color: #72c9ae;
}
.diagnostics {
  width: 300px;
  padding: 12px;
  border-radius: 16px;
  background-color: #18262c;
  flex-direction: column;
}
.diagnostics-title {
  font-size: 20px;
  color: #f4faf8;
  margin-bottom: 7px;
}
.diagnostics-line {
  width: 276px;
  min-height: 42px;
  margin-bottom: 5px;
  font-size: 16px;
  line-height: 19px;
  color: #b7c9c8;
  lines: 2;
  text-overflow: ellipsis;
}
.settings-back {
  width: 300px;
  height: 50px;
  margin-top: 12px;
  border-radius: 14px;
  background-color: #213239;
  color: #f4faf8;
  font-size: 20px;
  text-align: center;
}
.confirmation {
  width: 288px;
  padding: 16px;
  border-radius: 24px;
  background-color: #293d56;
  flex-direction: column;
  align-items: center;
}
.confirm-action {
  width: 100%;
  min-height: 52px;
  align-items: center;
  justify-content: center;
}
.confirm-icon {
  width: 34px;
  height: 34px;
  margin-right: 10px;
  object-fit: contain;
}
.confirm-title {
  max-width: 76%;
  color: #f4faf8;
  font-size: 22px;
  font-weight: bold;
  text-align: center;
  lines: 2;
  text-overflow: ellipsis;
}
.confirm-actions {
  width: 100%;
  margin-top: 16px;
  flex-direction: column;
}
.confirm-button, .cancel-button {
  width: 100%;
  height: 64px;
  border-radius: 18px;
  font-size: 23px;
  text-align: center;
}
.confirm-button {
  color: #142439;
  background-color: #c9ddf4;
  font-weight: bold;
}
.cancel-button {
  margin-top: 16px;
  color: #e7f3f2;
  background-color: #394f69;
}

