<template>
  <stack class="page">
    <div class="home-layout-pending" if="{{ !homeLayoutReady }}"></div>
    <scroll class="{{ ui.scrollPage }}" scroll-y="true" if="{{ homeLayoutReady && !useTwoPageShell }}">
      <div class="{{ ui.homeScreen }}">
        <div class="{{ ui.range + themePanelClass }}" @click="toggleRange">
          <div class="{{ ui.rangeHeader }}">
            <text class="{{ ui.model + themeInk }}">{{ vehicleName }}</text>
            <text class="{{ ui.motion + themeMuted }}">{{ motion || '—' }}</text>
          </div>
          <div class="range-summary" if="{{ !showTotalRange }}">
            <text class="{{ ui.distance + ' range-total' + themeInk }}"><span class="{{ ui.totalLabel + themeInk }}">总里程: </span>{{ total }}<span class="{{ ui.unit + themeMuted }}">{{ totalUnit }}</span></text>
            <div class="range-breakdown range-breakdown-summary">
              <div class="range-breakdown-reading" for="{{ rangeBreakdown }}" tid="id">
                <image class="{{ 'range-breakdown-icon' + (layoutProfile === 'capsule' ? ' range-breakdown-icon-narrow' : '') }}" src="{{ themeIconPath + 'energy-' + $item.id + '.png' }}"></image>
                <text class="{{ 'range-breakdown-value' + (layoutProfile === 'capsule' ? ' range-breakdown-value-narrow' : '') + themeMuted }}">{{ $item.value }}</text>
              </div>
            </div>
          </div>
          <image class="{{ ui.vehicleImage }}" if="{{ carImageSrc }}" src="{{ carImageSrc }}" @error="onCarImageError"></image>
          <div class="{{ ui.split }}" if="{{ showTotalRange }}">
            <div class="{{ ui.energy + themeControl }}">
              <div class="{{ ui.energyReading }}">
                <image class="{{ ui.energyIcon }}" src="{{ themeIconPath + 'energy-electric.png' }}"></image>
                <text class="{{ (electric.length > 3 ? ui.distanceCompact : ui.distance) + themeInk }}">{{ electric }}<span class="{{ ui.unit + themeMuted }}">{{ electricUnit }}</span></text>
              </div>
              <div class="{{ ui.energyTrack }}">
                <div class="{{ ui.energyFill }} electric-fill" if="{{ electricPercent > 0 }}" style="width: {{ electricPercent }}%"></div>
              </div>
            </div>
            <div class="{{ ui.energy + themeControl }}">
              <div class="{{ ui.energyReading }}">
                <image class="{{ ui.energyIcon }}" src="{{ themeIconPath + 'energy-fuel.png' }}"></image>
                <text class="{{ (fuel.length > 3 ? ui.distanceCompact : ui.distance) + themeInk }}">{{ fuel }}<span class="{{ ui.unit + themeMuted }}">{{ fuelUnit }}</span></text>
              </div>
              <div class="{{ ui.energyTrack }}">
                <div class="{{ ui.energyFill }} fuel-fill" if="{{ fuelPercent > 0 }}" style="width: {{ fuelPercent }}%"></div>
              </div>
            </div>
          </div>
          <div class="{{ ui.rangeIndicators }}">
            <div class="{{ showTotalRange ? ui.rangeDot : ui.activeRangeDot }}"></div>
            <div class="{{ showTotalRange ? ui.activeRangeDot : ui.rangeDot }}"></div>
          </div>
        </div>
        <div class="{{ ui.vehicleMeta + themePanelClass }}">
          <div class="{{ ui.refresh }}" @click="refresh">
            <image class="{{ ui.refreshIcon }}" src="{{ themeIconPath + 'refresh.png' }}"></image>
            <text class="{{ ui.updated + themeMuted }}">{{ refreshText }}</text>
          </div>
          <div class="{{ ui.metaDivider }}"></div>
          <div class="{{ ui.connection }}" @click="refresh">
            <div class="{{ ui.connectionStatus }}">
              <div class="{{ modeLabel === '已连接' || modeLabel === '演示' ? ui.dot + (themeDay ? ' online-day' : ' online') : ui.dot }}"></div>
              <text class="{{ ui.mode + themeMuted }}">{{ modeLabel }}</text>
            </div>
          </div>
        </div>
        <text class="{{ ui.empty + themeMuted + themeControl }}" if="{{ compatibilityNotice }}">{{ compatibilityNotice }}</text>
        <div class="{{ ui.grid }}" if="{{ !compatibilityNotice }}">
          <div class="{{ ui.controlRow }}" for="{{ displayRows }}" tid="id">
            <div class="{{ $item.first.style + themeTileClass + $item.first.tileStateStyle }}" @click="select($item.first.id)">
              <div class="{{ $item.first.symbolStyle + themeTileIconClass }}">
                <image class="{{ $item.first.iconStyle }}" src="{{ $item.first.icon }}" @error="onControlIconError($item.first.id)"></image>
              </div>
              <div class="{{ $item.first.copyStyle }}">
                <text class="{{ $item.first.labelStyle + $item.first.labelToneStyle }}">{{ $item.first.displayLabel }}</text>
                <text if="{{ $item.first.displayHint }}" class="{{ $item.first.hintStyle + themeMuted }}">{{ $item.first.displayHint }}</text>
              </div>
            </div>
          </div>
          <text class="{{ ui.empty + themeMuted + themeControl }}" if="{{ displayRows.length === 0 }}">{{ emptyLabel }}</text>
        </div>
      </div>
    </scroll>
    <stack class="{{ hasThemeSurface ? 'watch-shell' + themeStage : 'watch-shell watch-shell-classic' }}" if="{{ homeLayoutReady && useTwoPageShell }}">
      <swiper id="watchSwiper" class="watch-swiper" vertical="true" indicator="false" loop="false" index="{{ watchPage }}" @change="onWatchPageChange">
        <div class="{{ watchHomeUi.mileagePage + (hasThemeSurface ? themeStage : ' watch-mileage-page-classic') }}">
          <div class="watch-home-top">
            <div class="{{ 'watch-connection-row' + (layoutProfile === 'rect' ? ' watch-connection-row-rect' : '') }}">
              <text class="{{ 'watch-model-top-left' + themeInk }}" if="{{ layoutProfile === 'rect' }}">{{ vehicleName }}</text>
              <div class="watch-connection" @click="refresh">
                <div class="{{ (modeLabel === '已连接' || modeLabel === '演示') ? (themeDay ? 'dot online-day' : 'dot online') : 'dot' }}"></div>
                <text class="{{ 'watch-connection-text' + themeInk }}">{{ modeLabel }}</text>
              </div>
            </div>
            <div class="{{ watchHomeUi.heroHeader }}">
              <text class="{{ watchHomeUi.model + themeInk }}" if="{{ layoutProfile !== 'rect' }}">{{ vehicleName }}</text>
              <div class="watch-hero-num-row">
                <text class="{{ watchHomeUi.heroUnitGhost }}">{{ totalUnit || ' km' }}</text>
                <text class="{{ watchHomeUi.hero + themeInk }}">{{ total }}</text>
                <text class="{{ watchHomeUi.heroUnit + themeMuted }}">{{ totalUnit }}</text>
              </div>
              <div class="watch-energy-summary">
                <div class="watch-energy-item" for="{{ rangeBreakdown }}" tid="id">
                  <div class="watch-energy-reading">
                    <image class="watch-energy-icon" src="{{ themeIconPath + 'energy-' + $item.id + '.png' }}"></image>
                    <text class="{{ 'watch-energy-value' + themeInk }}">{{ $item.value }}</text>
                  </div>
                  <div class="{{ 'watch-energy-track' + (themeDay ? ' watch-energy-track-day' : '') }}">
                    <div class="{{ 'watch-energy-fill ' + $item.id + '-fill' }}" if="{{ $item.percent > 0 }}" style="width: {{ $item.percent }}%"></div>
                  </div>
                </div>
              </div>
            </div>
            <image class="{{ watchHomeUi.car }}" if="{{ carImageSrc }}" src="{{ carImageSrc }}" @error="onCarImageError"></image>
          </div>
          <div class="watch-home-footer">
            <div class="watch-motion-group">
              <image class="watch-motion-icon" if="{{ motion === '已驻车' }}" src="{{ themeIconPath + 'parking-status.png' }}"></image>
              <text class="{{ 'watch-motion' + themeInk }}">{{ motion }}</text>
            </div>
            <div class="watch-next-page" @click="setWatchPage(1)">
              <image class="watch-next-icon" src="{{ themeIconPath + 'chevron-down.png' }}"></image>
            </div>
          </div>
        </div>
        <div class="{{ watchControlsUi.controlsPage + (hasThemeSurface ? themeStage : ' watch-controls-page-classic') }}"
             @touchstart="startControlsPull" @touchmove="moveControlsPull" @touchend="endControlsPull">
          <div class="{{ watchControlsUi.topPill }}" @click="refresh">
            <div class="watch-top-pill-row">
              <image class="{{ watchControlsUi.refreshIcon }}" src="{{ themeIconPath + 'refresh.png' }}"></image>
              <text class="{{ watchControlsUi.topText + themeInk }}">{{ controlsPullText || refreshText }}</text>
            </div>
            <div class="{{ 'watch-pull-progress' + (themeDay ? ' watch-pull-progress-day' : '') }}" if="{{ controlsPullProgress > 0 || refreshing }}">
              <div class="{{ 'watch-pull-fill' + (themeDay ? ' watch-pull-fill-day' : '') }}" style="width: {{ refreshing ? 100 : controlsPullProgress }}%"></div>
            </div>
          </div>
          <text class="{{ watchControlsUi.empty + themeMuted + themeControl }}" if="{{ compatibilityNotice }}">{{ compatibilityNotice }}</text>
          <div class="{{ watchControlsUi.grid }}" if="{{ !compatibilityNotice }}">
            <div class="{{ watchControlsUi.controlRow }}" for="{{ displayRows }}" tid="id">
              <div class="{{ $item.first.watchCellStyle + themeTileClass + $item.first.watchCellStateStyle }}" @click="select($item.first.id)">
                <div class="{{ $item.first.watchOrbStyle + ' ' + $item.first.watchOrbSizeStyle + $item.first.watchOrbDayStyle }}">
                  <image class="{{ $item.first.watchOrbIconStyle }}" src="{{ $item.first.icon }}" @error="onControlIconError($item.first.id)"></image>
                </div>
                <div class="{{ $item.first.watchCellCopyStyle }}">
                  <text class="{{ $item.first.watchCellLabelStyle + $item.first.labelToneStyle }}">{{ $item.first.displayLabel }}</text>
                  <text if="{{ $item.first.displayHint }}" class="{{ 'watch-cell-hint' + themeMuted }}">{{ $item.first.displayHint }}</text>
                </div>
              </div>
            </div>
            <text class="{{ watchControlsUi.empty + themeMuted + themeControl }}" if="{{ displayRows.length === 0 }}">{{ emptyLabel }}</text>
          </div>
        </div>
      </swiper>
      <div class="{{ watchControlsUi.pager }}">
        <div class="{{ watchPage === 0 ? 'watch-pager-dot watch-pager-active' + (themeDay ? ' watch-pager-active-day' : '') : 'watch-pager-dot' + (themeDay ? ' watch-pager-dot-day' : '') }}" @click="setWatchPage(0)"></div>
        <div class="{{ watchPage === 1 ? 'watch-pager-dot watch-pager-active' + (themeDay ? ' watch-pager-active-day' : '') : 'watch-pager-dot' + (themeDay ? ' watch-pager-dot-day' : '') }}" @click="setWatchPage(1)"></div>
      </div>
    </stack>
    <div class="confirm-overlay" if="{{ confirmTitle }}" @touchstart="clearControlsPull">
      <div class="{{ ui.confirmation + (themeDay ? ' theme-confirmation-day' : '') }}">
        <div class="{{ ui.confirmAction }}">
          <image class="{{ ui.confirmIcon }}" src="{{ themeConfirmIcon }}"></image>
          <text class="{{ ui.confirmTitle + themeInk }}">{{ confirmTitle }}</text>
        </div>
        <div class="{{ ui.confirmActions }}">
          <text class="{{ ui.confirmButton }}" @click="execute">确认</text>
          <text class="{{ ui.cancelButton + themeInk + themeControl }}" @click="cancel">取消</text>
        </div>
      </div>
    </div>
    <div class="{{ ui.toast + themeControl }}" if="{{ toastText && !confirmTitle }}">
      <text class="{{ ui.toastText + themeInk }}">{{ toastText }}</text>
    </div>
  </stack>
</template>

<script>
import { createGaragePage } from '../../common/garage-page.js'

export default createGaragePage({ lite: true })
</script>

